local function getCharacter(speaker)
  return speaker.Character or speaker.CharacterAdded:Wait()
end

local function getHumanoid(speaker)
  local char = getCharacter(speaker)
  return char:FindFirstChildOfClass("Humanoid") or char:FindFirstChildOfClass("AnimationController")
end

local function isR15(speaker)
  local char = getCharacter(speaker)
  return char:FindFirstChild("UpperTorso") ~= nil
end

local function stopAllTracks()
  for _, track in pairs(activeTracks) do
    pcall(function() track:Stop() end)
  end
  activeTracks = {}
  if currentDanceTrack then
    pcall(function() currentDanceTrack:Stop() end)
    currentDanceTrack = nil
  end
  if spasmTrack then
    pcall(function() spasmTrack:Stop() end)
    spasmTrack = nil
  end
  if spasmAnim then
    spasmAnim = nil
  end end

local function playAnimation(speaker, animId, speed, looped, fadeTime)
  local hum = getHumanoid(speaker)
  if not hum then return nil end
  stopAllTracks()
  local anim = Instance.new("Animation")
  anim.AnimationId = "rbxassetid://" .. tostring(animId)
  local track = hum:LoadAnimation(anim)
  track.Looped = looped or false
  track:Play(fadeTime or 0, 1, 0)
  track:AdjustSpeed(speed or 1)
  table.insert(activeTracks, track)
  return track
end

