local function buildUIEditorTab(ctx)
  local Window = ctx.Window

  local Players = svc("Players")
  local UserInputService = svc("UserInputService")
  local HttpService = svc("HttpService")
  local GuiService = svc("GuiService")

  local LocalPlayer = Players.LocalPlayer
  local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

  local guiInset = Vector2.new(0, 0)
  pcall(function()
    guiInset = svc("GuiService"):GetGuiInset()
  end)

  local Tab = ctx.Tabs.UIEditor
  if not Tab then
    Tab = Window:Tab({ Title = "修改键位", Icon = "mouse-pointer-click" })
  end

  local widthSlider, heightSlider
  local selectedLabel

  local editMode = false
  local selectedButton = nil
  local trackedButtons = {}
  local trackedSet = {}
  local originalData = {}
  local buttonStrokes = {}
  local buttonConnections = {}
  local charAddedConn = nil
  local dragState = {
    dragging = false,
    dragInput = nil,
    startPos = nil,
    startInput = nil,
  }
  local updatingSliders = false
  local pickAnyMode = false
  local passthroughMode = false
  local overlayGui = nil
  local overlayBtn = nil
  local lastHandledInput = nil
  local lastHitPos = nil
  local lastHits = {}
  local lastHitIndex = 0

  local SAVE_FOLDER = "黑白脚本"
  local SAVE_FILE = "UI按键布局.txt"
  local hasFileSystem = pcall(function()
    return isfolder and makefolder and isfile and readfile and writefile
  end)
  if hasFileSystem then
    pcall(function()
      if not isfolder(SAVE_FOLDER) then
        makefolder(SAVE_FOLDER)
      end
    end)
  end

  local function getButtonName(btn)
    local name = btn.Name
    if not name or name == "" or name == "TextButton" or name == "ImageButton" then
      local parent = btn.Parent
      name = (parent and parent.Name or "Unknown") .. "." .. btn.ClassName
    end
    return name
  end

  local function getSaveKey(btn)
    local ok, fullName = pcall(function() return btn:GetFullName() end)
    if ok and fullName and fullName ~= "" then
      return fullName
    end
    return getButtonName(btn)
  end

  local function addStroke(btn, color)
    local existing = btn:FindFirstChild("UIEditor_Stroke")
    if existing then
      existing:Destroy()
    end
    local stroke = Instance.new("UIStroke")
    stroke.Name = "UIEditor_Stroke"
    stroke.Color = color or Color3.fromRGB(0, 255, 0)
    stroke.Thickness = 2.5
    stroke.Transparency = 0.1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = btn
    buttonStrokes[btn] = stroke
  end

  local function removeStroke(btn)
    local stroke = buttonStrokes[btn]
    if stroke then
      stroke:Destroy()
      buttonStrokes[btn] = nil
    end end

  local function scanAllButtons()
    local result = {}
    pcall(function()
      for _, desc in ipairs(PlayerGui:GetDescendants()) do

        if desc:IsA("TextButton") or desc:IsA("ImageButton") then

          local inWindUI = desc:FindFirstAncestor("WindUI")
               or desc:FindFirstAncestor("CloudHub")
               or desc:FindFirstAncestor("UIEditor_Overlay")
          if not inWindUI then
            table.insert(result, desc)
          end end
      end
    end)
    return result
  end

  local function updateSelectedLabel()
    pcall(function()
      if selectedButton then
        selectedLabel:SetDesc("当前选中: " .. getButtonName(selectedButton))
      else
        selectedLabel:SetDesc("未选中任何按键")
      end
    end)
  end

  local function updateSlidersForButton(btn)
    if not btn then return end
    updatingSliders = true
    local absSize = btn.AbsoluteSize
    pcall(function() widthSlider:SetValue(math.floor(absSize.X)) end)
    pcall(function() heightSlider:SetValue(math.floor(absSize.Y)) end)
    updatingSliders = false
  end

  local function createOverlay()
    if overlayGui then return end
    overlayGui = Instance.new("ScreenGui")
    overlayGui.Name = "UIEditor_Overlay"
    overlayGui.ResetOnSpawn = false

    overlayGui.DisplayOrder = 998
    pcall(function()
      local panel = PlayerGui:FindFirstChild("WindUI")
        or PlayerGui:FindFirstChild("CloudHub")
        or svc("CoreGui"):FindFirstChild("WindUI")
        or svc("CoreGui"):FindFirstChild("CloudHub")
      if panel and panel:IsA("ScreenGui") then
        overlayGui.DisplayOrder = math.max(panel.DisplayOrder - 1, 0)
      end
    end)
    overlayGui.Enabled = false

    overlayBtn = Instance.new("TextButton")
    overlayBtn.Name = "HitLayer"
    overlayBtn.Size = UDim2.fromScale(1, 1)
    overlayBtn.BackgroundTransparency = 1
    overlayBtn.Text = ""
    overlayBtn.AutoButtonColor = false
    overlayBtn.BorderSizePixel = 0
    overlayBtn.Parent = overlayGui

    overlayGui.Parent = PlayerGui
  end

  local function isOurs(obj)
    if overlayGui and obj:IsDescendantOf(overlayGui) then
      return true
    end
    return obj:FindFirstAncestor("WindUI") ~= nil
      or obj:FindFirstAncestor("CloudHub") ~= nil
  end

  local function getObjectsAt(x, y)
    local objs = {}
    pcall(function()
      for _, o in ipairs(PlayerGui:GetGuiObjectsAtPosition(x, y)) do
        table.insert(objs, o)
      end
    end)
    pcall(function()
      for _, o in ipairs(svc("CoreGui"):GetGuiObjectsAtPosition(x, y)) do
        table.insert(objs, o)
      end
    end)
    return objs
  end

  local function collectHits(x, y)
    local hits = {}
    local inList = {}
    for _, obj in ipairs(getObjectsAt(x, y)) do
      if obj:IsA("GuiObject") and not isOurs(obj) then

        local node = obj
        local found = nil
        while node and node ~= PlayerGui do
          if trackedSet[node] then
            found = node
            break
          end
          node = node.Parent
        end
        local target = found
        if not target and pickAnyMode then
          target = obj
        end
        if target and not inList[target] then
          inList[target] = true
          table.insert(hits, target)
        end end
    end
    return hits
  end

  local function sameList(a, b)
    if #a ~= #b then return false end
    for i = 1, #a do
      if a[i] ~= b[i] then return false end
    end
    return true
  end

  local function selectButton(btn)
    if selectedButton and selectedButton ~= btn then
      addStroke(selectedButton, Color3.fromRGB(0, 255, 0))
    end
    selectedButton = btn
    if not originalData[btn] then
      originalData[btn] = {
        Position = btn.Position,
        Size = btn.Size,
      }
    end
    if not trackedSet[btn] then
      trackedSet[btn] = true
      table.insert(trackedButtons, btn)
    end
    addStroke(btn, Color3.fromRGB(255, 255, 0))
    updateSelectedLabel()
    updateSlidersForButton(btn)
  end

  local function handlePress(input)
    if not editMode then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
    and input.UserInputType ~= Enum.UserInputType.Touch then
      return
    end
    if input == lastHandledInput then return end
    lastHandledInput = input

    local x, y = input.Position.X - guiInset.X, input.Position.Y - guiInset.Y

    for _, obj in ipairs(getObjectsAt(x, y)) do
      if obj:IsA("GuiObject") and isOurs(obj)
      and not (overlayGui and obj:IsDescendantOf(overlayGui)) then
        return
      end end

    local hits = collectHits(x, y)
    local pos = Vector2.new(x, y)

    if #hits == 0 then

      if selectedButton then
        addStroke(selectedButton, Color3.fromRGB(0, 255, 0))
        selectedButton = nil
        updateSelectedLabel()
      end
      lastHits = {}
      lastHitIndex = 0
      lastHitPos = pos
      return
    end

    if lastHitPos and (pos - lastHitPos).Magnitude <= 12 and sameList(hits, lastHits) then
      lastHitIndex = lastHitIndex % #hits + 1
    else
      lastHitIndex = 1
    end
    lastHitPos = pos
    lastHits = hits

    local btn = hits[lastHitIndex]
    selectButton(btn)

    dragState.dragging = true
    dragState.dragInput = input
    dragState.startPos = btn.Position
    dragState.startInput = input.Position
  end

  local function enterEditMode()
    if editMode then return end
    editMode = true

    createOverlay()

    trackedButtons = scanAllButtons()
    trackedSet = {}
    for _, btn in ipairs(trackedButtons) do
      trackedSet[btn] = true

      if not originalData[btn] then
        originalData[btn] = {
          Position = btn.Position,
          Size = btn.Size,
        }
      end

      addStroke(btn, Color3.fromRGB(0, 255, 0))
    end

    if overlayGui then
      overlayGui.Enabled = not passthroughMode
    end

    table.insert(buttonConnections, overlayBtn.InputBegan:Connect(function(input)
      handlePress(input)
    end))

    table.insert(buttonConnections, UserInputService.InputBegan:Connect(function(input)
      handlePress(input)
    end))

    table.insert(buttonConnections, UserInputService.InputChanged:Connect(function(input)
      if not editMode or not dragState.dragging then return end
      if input.UserInputType == Enum.UserInputType.MouseMovement
      or input.UserInputType == Enum.UserInputType.Touch then
        if dragState.dragInput and dragState.startPos
        and dragState.startInput and selectedButton then
          local delta = input.Position - dragState.startInput
          selectedButton.Position = UDim2.new(
            dragState.startPos.X.Scale,
            dragState.startPos.X.Offset + delta.X,
            dragState.startPos.Y.Scale,
            dragState.startPos.Y.Offset + delta.Y
          )
        end end
    end))

    table.insert(buttonConnections, UserInputService.InputEnded:Connect(function(input)

      if dragState.dragging and dragState.dragInput
      and input.UserInputType == dragState.dragInput.UserInputType then
        dragState.dragging = false
        dragState.dragInput = nil
      end
    end))

    WindUI:Notify({
      Title = "UI编辑",
      Content = "编辑模式已开启, 点击按键可选中并拖动",
      Duration = 3,
    })
  end

  local function exitEditMode()
    if not editMode then return end
    editMode = false

    for _, conn in ipairs(buttonConnections) do
      pcall(function() conn:Disconnect() end)
    end
    buttonConnections = {}

    if overlayGui then
      overlayGui.Enabled = false
    end

    for _, btn in ipairs(trackedButtons) do
      removeStroke(btn)
    end
    trackedButtons = {}
    trackedSet = {}
    lastHandledInput = nil
    lastHitPos = nil
    lastHits = {}
    lastHitIndex = 0

    selectedButton = nil
    dragState = {
      dragging = false,
      dragInput = nil,
      startPos = nil,
      startInput = nil,
    }
    updateSelectedLabel()

    _N("UI编辑", "编辑模式已关闭")
  end

  local function saveLayout()
    if not hasFileSystem then
      WindUI:Notify({
        Title = "UI编辑",
        Content = "当前执行环境不支持文件保存",
        Duration = 3,
      })
      return
    end

    local data = {}
    for btn, _ in pairs(originalData) do
      if btn and btn.Parent then
        local name = getSaveKey(btn)
        data[name] = {
          Position = {
            btn.Position.X.Scale, btn.Position.X.Offset,
            btn.Position.Y.Scale, btn.Position.Y.Offset,
          },
          Size = {
            btn.Size.X.Scale, btn.Size.X.Offset,
            btn.Size.Y.Scale, btn.Size.Y.Offset,
          },
        }
      end end

    local ok = pcall(function()
      writefile(SAVE_FOLDER .. "/" .. SAVE_FILE, HttpService:JSONEncode(data))
    end)

    if ok then
      _N("UI编辑", "按键布局已保存")
    else
      WindUI:Notify({
