LeftGroupBox:Button({
  Title = "应用",
  Tooltip = "点击将Roblox的名称和服装应用到你的角色",
  Callback = function()
    local name = victimName
    if name == "" then
      WindUI:Notify({ Title = "错误", Content = "请输入Roblox名称", Duration = 3 })
      return
    end

    pcall(function()
      local function getUserIdByUsername(username)
        local success, result = pcall(function()
          return game:HttpGet("https://users.roblox.com/v1/users/search?keyword=" .. username, true)
        end)
        if success then
          local data = HttpService:JSONDecode(result)
          if data and data.data and #data.data > 0 then
            return data.data[1].id, data.data[1].name, data.data[1].displayName
          end end
        return nil, nil, nil
      end

      local userId, userName, displayName = getUserIdByUsername(name)
      if not userId then
        WindUI:Notify({ Title = "错误", Content = "玩家未找到", Duration = 3 })
        return
      end

      local function applyCharacterAppearance(character, uid)
        local appearance = Players:GetCharacterAppearanceAsync(uid)
        for i, v in ipairs(character:GetChildren()) do
          if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then
            v:Destroy()
          end end
        for i, v in ipairs(appearance:GetChildren()) do
          if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then
            v.Parent = character
          elseif v:IsA("Accessory") then
            character.Humanoid:AddAccessory(v)
          end end
        if appearance:FindFirstChild("face") then
          if character:WaitForChild("Head"):FindFirstChild("face") then
            character.Head.face:Destroy()
          end
          appearance.face.Parent = character.Head
        else
          if character:WaitForChild("Head"):FindFirstChild("face") then
            character.Head.face:Destroy()
          end
          local face = Instance.new("Decal")
          face.Face = "Front"
          face.Name = "face"
          face.Texture = "rbxasset://textures/face.png"
          face.Transparency = 0
          face.Parent = character.Head
        end
        local parent = character.Parent
        character.Parent = nil
        character.Parent = parent
      end

      local function updatePlayerListName(newName)
        if LocalPlayer and LocalPlayer.PlayerGui and LocalPlayer.PlayerGui.MainUI and
         LocalPlayer.PlayerGui.MainUI.PlayerListHolder and
         LocalPlayer.PlayerGui.MainUI.PlayerListHolder.Contents and
         LocalPlayer.PlayerGui.MainUI.PlayerListHolder.Contents.Players then
          local myEntry = LocalPlayer.PlayerGui.MainUI.PlayerListHolder.Contents.Players[LocalPlayer.Name]
          if myEntry and myEntry.PlayerInfo and myEntry.PlayerInfo.Username then
            myEntry.PlayerInfo.Username.Text = newName
          end end
      end

      if not LocalPlayer.Character then
        LocalPlayer.CharacterAdded:Wait()
      end
      repeat task.wait() until LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")

      LocalPlayer.Name = userName
      LocalPlayer.UserId = userId
      LocalPlayer.CharacterAppearanceId = userId
      LocalPlayer.DisplayName = displayName

      LocalPlayer.Character.Name = userName
      if LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.DisplayName = displayName
      end

      applyCharacterAppearance(LocalPlayer.Character, userId)

      updatePlayerListName(displayName)

      LocalPlayer.CharacterAdded:Connect(function(character)
        task.wait(0.5)
        if character and character:FindFirstChild("Humanoid") then
          character.Name = userName
          if character:FindFirstChild("Humanoid") then
            character.Humanoid.DisplayName = displayName
          end
          applyCharacterAppearance(character, userId)
        end
      end)

      WindUI:Notify({
        Title = "成功",
        Content = string.format("已将名称更改为: %s\n并应用了 %s 的服装", displayName, name),
        Duration = 5,
      })
    end)
  end })

