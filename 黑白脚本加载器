      end
      if sustain then
        pcall(function() virtual_input:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
        sustain = false
      end
      active_notes = {}
    end

    local function get_current_playback_position()
      if paused then
        return pause_position
      else
        return (os.clock() - start_time) * playback_speed
      end end

    local function play_realtime_events()
      if paused then return end
      local elapsed = get_current_playback_position()

      while next_event_index <= #events do
        local ev = events[next_event_index]
        local event_time = ev.abs_time

        if ev.type == "off" and random_note_enabled then
          local random_offset = (_math.random(0,15) * 0.01)
          event_time = ev.abs_time - random_offset
          if event_time < 0 then event_time = 0 end
        end

        if ev.type == "on" and random_note_enabled then
          local random_offset = _math.random(0, 5) * 0.01
          event_time = ev.abs_time - random_offset
          if event_time < 0 then event_time = 0 end
        end

        if event_time <= elapsed then
          if ev.type == "on" then
            local k = key_map[ev.note]
            if k then
              if not key88_enabled and k.ctrl then
                next_event_index = next_event_index + 1
                continue
              end
              if k.ctrl and not ctrl then
                virtual_input:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, game)
                ctrl = true
              elseif not k.ctrl and ctrl then
                virtual_input:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
                ctrl = false
              end
              if k.shift and not shift then
                virtual_input:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
                shift = true
              elseif not k.shift and shift then
                virtual_input:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
                shift = false
              end
              virtual_input:SendKeyEvent(true, k.keycode, false, game)
              active_notes[ev.note] = k
              if no_note_off_enabled then
                virtual_input:SendKeyEvent(false, k.keycode, false, game)
                active_notes[ev.note] = nil
              end end
          elseif ev.type == "off" then
            if not no_note_off_enabled then
              local k = active_notes[ev.note]
              if k then
                virtual_input:SendKeyEvent(false, k.keycode, false, game)
                active_notes[ev.note] = nil
              end end
          elseif ev.type == "control" then
            local s = ev.vel >= 64
            if auto_sustain_enabled then
              if s ~= sustain then
                virtual_input:SendKeyEvent(s, Enum.KeyCode.Space, false, game)
                sustain = s
              end
            else
              if not sustain then
                virtual_input:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                sustain = true
              end end
          end
          next_event_index = next_event_index + 1
        else
          break
        end end

      if next_event_index > #events then
        paused = true
        start_time = 0
        next_event_index = 1
        pause_time = 0
        pause_position = 0
        release_all_keys()
      end end

    local startMidiRenderConn, stopMidiRenderConn

    local function start_playback(parsed_events, tempo_changes)
      events = parsed_events
      tempo_events = tempo_changes or {}
      total_duration = events[#events] and events[#events].abs_time or 0
      start_time = os.clock()
      next_event_index = 1
      pause_position = 0
      release_all_keys()
      paused = false
      midi_loaded = true
      startMidiRenderConn()
    end

    local function pause_playback()
      if not paused then
        paused = true
        pause_time = os.clock()
        pause_position = (os.clock() - start_time) * playback_speed
        release_all_keys()
        stopMidiRenderConn()
      end end

    local function resume_playback()
      if paused then
        start_time = os.clock() - (pause_position / playback_speed)
        paused = false
        startMidiRenderConn()
      end end

    local function stop_playback()
      paused = true
      start_time = 0
      next_event_index = 1
      pause_time = 0
      pause_position = 0
      release_all_keys()
      stopMidiRenderConn()
    end

    local function seek_to_position(ratio)
      local target_time = total_duration * ratio
      pause_position = target_time
      next_event_index = 1
      for i = 1, #events do
        if events[i].abs_time > target_time then
          next_event_index = i
          break
        end end
      if not paused then
        start_time = os.clock() - (target_time / playback_speed)
      end
      release_all_keys()
    end

