  "红", "绿", "蓝", "黄", "紫", "青", "白", "黑", "彩虹"
}
local materialOptions = {
  "Neon", "ForceField", "Plastic", "Metal", "Glass"
}

local function getColorFromString(str)
  local colors = {
    ["红"] = Color3.new(1,0,0),
    ["绿"] = Color3.new(0,1,0),
    ["蓝"] = Color3.new(0,0,1),
    ["黄"] = Color3.new(1,1,0),
    ["紫"] = Color3.new(1,0,1),
    ["青"] = Color3.new(0,1,1),
    ["白"] = Color3.new(1,1,1),
    ["黑"] = Color3.new(0,0,0)
  }
  return colors[str] or Color3.new(1,0,0)
end

local function getMaterialFromString(str)
  local mats = {
    ["Neon"] = Enum.Material.Neon,
    ["ForceField"] = Enum.Material.ForceField,
    ["Plastic"] = Enum.Material.Plastic,
    ["Metal"] = Enum.Material.Metal,
    ["Glass"] = Enum.Material.Glass
  }
  return mats[str] or Enum.Material.Neon
end

local function clearAllHitboxes()
  for _, conn in pairs(hitboxConnections) do
    pcall(function() conn:Disconnect() end)
  end
  hitboxConnections = {}
  for player, data in pairs(hitboxObjects) do
    pcall(function()
      if data.Highlight then data.Highlight:Destroy() end
    end)
  end
  hitboxObjects = {}
end

local function applyHitboxToPlayer(player)
  if not player or not player.Character then return end
  local root = player.Character:FindFirstChild("HumanoidRootPart")
  local head = player.Character:FindFirstChild("Head")
  if not root then return end

  local data = hitboxObjects[player] or {}
  hitboxObjects[player] = data

  if HitboxEnabled then
    root.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
    root.Transparency = HitboxTransparency
    root.BrickColor = BrickColor.new(HitboxColor)
    root.Material = getMaterialFromString(HitboxMaterial)
    root.CanCollide = HitboxCanCollide

    if not data.Highlight and HitboxGlowEffect then
      local hl = Instance.new("Highlight")
      hl.FillTransparency = 1
      hl.OutlineColor = HitboxColor
      hl.OutlineTransparency = 0.2
      hl.Adornee = root
      hl.Parent = player.Character
      data.Highlight = hl
    end end

  if HeadSizeEnabled and head then
    head.Size = Vector3.new(HeadSize, HeadSize, HeadSize)
    head.Transparency = HeadSizeTransparency
    head.BrickColor = BrickColor.new(HeadSizeColor)
    head.Material = getMaterialFromString(HeadSizeMaterial)
    head.CanCollide = HeadSizeCanCollide
  end end

local function refreshAllHitboxes()
  for _, plr in ipairs(game.Players:GetPlayers()) do
    applyHitboxToPlayer(plr)
  end end

local function startHitboxFunction()
  clearAllHitboxes()
  HitboxEnabled = true
  refreshAllHitboxes()

  local conn = game.Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
      task.wait(0.3)
      applyHitboxToPlayer(plr)
    end)
  end)
  table.insert(hitboxConnections, conn)
end

local function stopHitboxFunction()
  HitboxEnabled = false
  clearAllHitboxes()
  for _, plr in ipairs(game.Players:GetPlayers()) do
    if plr.Character then
      local root = plr.Character:FindFirstChild("HumanoidRootPart")
      local head = plr.Character:FindFirstChild("Head")
      if root then
        root.Size = Vector3.new(2,2,2)
        root.Transparency = 1
        root.BrickColor = BrickColor.Gray()
        root.Material = Enum.Material.Plastic
        root.CanCollide = true
      end
      if head then
        head.Size = Vector3.new(1,1,1)
        head.Transparency = 0
      end end
  end end

local function resetHitboxSettingsFunction()
  HitboxEnabled = false
  HitboxSize = 25
  HitboxTransparency = 0.7
  HitboxColor = Color3.new(1,0,0)
  HitboxMaterial = "Neon"
  HitboxCanCollide = true
