end

local function onTrackFOVColor(value)
  if value == "彩虹" then
    bulletTrackRainbow = true
  else
    bulletTrackRainbow = false
    local colors = {
      ["白"] = Color3.new(1, 1, 1),
      ["红"] = Color3.new(1, 0, 0),
      ["黄"] = Color3.new(1, 1, 0),
      ["蓝"] = Color3.new(0, 0, 1),
      ["绿"] = Color3.new(0, 1, 0),
      ["青"] = Color3.new(0, 1, 1),
      ["紫"] = Color3.new(1, 0, 1)
    }
    bulletTrackFOVColor = colors[value]
  end end

