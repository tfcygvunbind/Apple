local function ToggleTouchBlocker(state)
  triggerState.TouchBlockEnabled = state
  if state then
    task.spawn(function()
      while triggerState.TouchBlockEnabled do
        local char = Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
          local hrp = char.HumanoidRootPart
          local parts = workspace:GetPartBoundsInRadius(hrp.Position, 10)
          for _, part in ipairs(parts) do
            if part:IsA("BasePart") then
              pcall(function() part.CanTouch = false end)
            end end
        end
        task.wait(0.1)
      end
    end)
  else
    for _, part in ipairs(workspace:GetDescendants()) do
      if part:IsA("BasePart") and part.CanTouch == false then
        pcall(function() part.CanTouch = true end)
      end end
  end end

