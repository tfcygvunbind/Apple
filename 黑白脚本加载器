  local function makeDrag(obj, handle)
    handle = handle or obj
    local state = {}
    local function onInputBegan(input)
      if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        state[input] = {
          object = obj,
          startPos = obj.Position,
          dragStart = input.Position,
          isDragging = true
        }
      end end
    local function onInputEnded(input)
      if state[input] and state[input].object == obj then
        state[input] = nil
      end end
    local function onInputChanged(input)
      if state[input] and state[input].isDragging then
        local delta = input.Position - state[input].dragStart
        obj.Position = UDim2.new(
          state[input].startPos.X.Scale,
          state[input].startPos.X.Offset + delta.X,
          state[input].startPos.Y.Scale,
          state[input].startPos.Y.Offset + delta.Y
        )
      end end
    handle.InputBegan:Connect(onInputBegan)
    handle.InputEnded:Connect(onInputEnded)
    UserInputService.InputChanged:Connect(onInputChanged)
    table.insert(clickerConns, handle.InputBegan:Connect(onInputBegan))
    table.insert(clickerConns, handle.InputEnded:Connect(onInputEnded))
    table.insert(clickerConns, UserInputService.InputChanged:Connect(onInputChanged))
  end

