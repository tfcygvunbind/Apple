      sportsCar = car
      local function disableAllPhysics(obj)
        if obj:IsA("Part") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
          obj.CanCollide = false
          obj.CanTouch = false
          obj.CanQuery = false
          obj.Anchored = true
          obj.Massless = true
          obj.CastShadow = false
          for _, conn in ipairs(obj:GetChildren()) do
            if conn:IsA("Weld") or conn:IsA("WeldConstraint") or
             conn:IsA("Attachment") or conn:IsA("Constraint") then
              conn:Destroy()
            end end
        elseif obj:IsA("Model") then
          for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("Part") or child:IsA("MeshPart") or child:IsA("UnionOperation") then
              child.CanCollide = false
              child.CanTouch = false
              child.CanQuery = false
              child.Anchored = true
              child.Massless = true
              child.CastShadow = false
              for _, conn in ipairs(child:GetChildren()) do
                if conn:IsA("Weld") or conn:IsA("WeldConstraint") or
                 conn:IsA("Attachment") or conn:IsA("Constraint") then
                  conn:Destroy()
                end end
            end end
        end end
      disableAllPhysics(sportsCar)
      sportsCar.Parent = workspace
      sportsCar:SetAttribute("NoCollision", true)
      local carSize = sportsCar:GetExtentsSize()
      if sportsCarConnection then
        sportsCarConnection:Disconnect()
        sportsCarConnection = nil
