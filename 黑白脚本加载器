local function loadScript(data)
    if type(data) == "function" then
        pcall(data)
    else
        pcall(function()
            loadstring(game:HttpGet(data))()
        end)
    end
end

local APPLE_URL = 'https://raw.githubusercontent.com/tfcygvunbind/Apple/main/1'

if games[PlaceId] then
    local loadedSignal = Instance.new("BindableEvent")

    task.spawn(function()
        loadScript(games[PlaceId])
        loadedSignal:Fire()
    end)

    task.spawn(function()
        loadedSignal.Event:Wait()
        local useCommon = showPopupAndWait()
        if useCommon then
            pcall(function()
                loadstring(game:HttpGet(APPLE_URL))()
            end)
        end
    end)
else
    pcall(function()
        loadstring(game:HttpGet(APPLE_URL))()
    end)
end
