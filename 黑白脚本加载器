local function SitOnAllSeats()
  local char = Players.LocalPlayer.Character
  if not char or not char:FindFirstChild("HumanoidRootPart") then return end
  local hrp = char.HumanoidRootPart
  for _, seat in ipairs(workspace:GetDescendants()) do
    if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
      pcall(function()
        if firetouchinterest then
          firetouchinterest(hrp, seat, 0)
          task.wait()
          firetouchinterest(hrp, seat, 1)
        end
      end)
    end end
end

local function StartAutoEnterVehicle()
  triggerState.AutoEnterVehicle = true
  task.spawn(function()
    while triggerState.AutoEnterVehicle do
      local char = Players.LocalPlayer.Character
      if char and char:FindFirstChild("Humanoid") and char.Humanoid.SeatPart == nil then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
          for _, seat in ipairs(workspace:GetDescendants()) do
            if (seat:IsA("Seat") or seat:IsA("VehicleSeat")) and seat.Occupant == nil then
              if (hrp.Position - seat.Position).Magnitude <= (triggerState.VehicleRange or 30) then
                pcall(function()
                  if firetouchinterest then
                    firetouchinterest(hrp, seat, 0)
                    task.wait()
                    firetouchinterest(hrp, seat, 1)
                  end
                end)
              end end
          end end
      end
      task.wait(0.5)
    end
  end)
end

