          local backOffset = hrp.CFrame.LookVector * -2
          local heightOffset = Vector3.new(0, carSize.Y / 2 - 4.5, 0)
          local targetPosition = hrp.Position + rightOffset + backOffset + heightOffset
          local lookVector = hrp.CFrame.LookVector
          local rightVector = hrp.CFrame.RightVector
          local upVector = hrp.CFrame.UpVector
          local targetCFrame = CFrame.fromMatrix(targetPosition, rightVector, upVector, -lookVector)
          sportsCar:PivotTo(targetCFrame)
        end
