local PlaceId = game.PlaceId
local lplr = game:GetService("Players").LocalPlayer

local function showPopupAndWait()
    local TweenService = svc("TweenService")
    local popupGui = Instance.new("ScreenGui")
    popupGui.Name = "KongScriptPopup"
    popupGui.ResetOnSpawn = false
    popupGui.IgnoreGuiInset = true
    popupGui.DisplayOrder = 2147483647
    local coreOk, coreGui = pcall(function()
        return svc("CoreGui")
    end)
    popupGui.Parent = (coreOk and coreGui) or lplr:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Name = "PopupFrame"
    frame.Size = UDim2.new(0, 225, 0, 112.5)
    frame.Position = UDim2.new(1, 240, 0, 15)
    frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    frame.BorderSizePixel = 0
    frame.Parent = popupGui
    local frameCorner = Instance.new("UICorner")
    frameCorner.CornerRadius = UDim.new(0, 10.5)
    frameCorner.Parent = frame

    local closeBtn = Instance.new("TextButton")
    closeBtn.Name = "CloseBtn"
    closeBtn.Size = UDim2.new(0, 22.5, 0, 22.5)
    closeBtn.Position = UDim2.new(1, -27, 0, 4.5)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.fromRGB(60, 60, 60)
    closeBtn.TextSize = 13.5
    closeBtn.Font = Enum.Font.SourceSansBold
    closeBtn.Parent = frame

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "TitleLabel"
    titleLabel.Size = UDim2.new(1, -15, 0, 22.5)
    titleLabel.Position = UDim2.new(0, 7.5, 0, 25.5)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = "是否额外加载通用脚本"
    titleLabel.TextColor3 = Color3.fromRGB(30, 30, 30)
    titleLabel.TextSize = 12.75
    titleLabel.Font = Enum.Font.SourceSansBold
    titleLabel.Parent = frame

    local timeLabel = Instance.new("TextLabel")
    timeLabel.Name = "TimeLabel"
    timeLabel.Size = UDim2.new(1, -15, 0, 18)
    timeLabel.Position = UDim2.new(0, 7.5, 0, 51)
    timeLabel.BackgroundTransparency = 1
    timeLabel.Text = "7:00"
    timeLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
    timeLabel.TextSize = 11.25
    timeLabel.Font = Enum.Font.SourceSans
    timeLabel.Parent = frame

    local yesBtn = Instance.new("TextButton")
    yesBtn.Name = "YesBtn"
    yesBtn.Size = UDim2.new(0, 90, 0, 25.5)
    yesBtn.Position = UDim2.new(0, 15, 1, -34.5)
    yesBtn.BackgroundColor3 = Color3.fromRGB(235, 235, 235)
    yesBtn.Text = "是"
    yesBtn.TextColor3 = Color3.fromRGB(30, 30, 30)
    yesBtn.TextSize = 12
    yesBtn.Font = Enum.Font.SourceSansBold
    yesBtn.Parent = frame
    local yesCorner = Instance.new("UICorner")
    yesCorner.CornerRadius = UDim.new(0, 7.5)
    yesCorner.Parent = yesBtn

    local noBtn = Instance.new("TextButton")
    noBtn.Name = "NoBtn"
    noBtn.Size = UDim2.new(0, 90, 0, 25.5)
    noBtn.Position = UDim2.new(1, -105, 1, -34.5)
    noBtn.BackgroundColor3 = Color3.fromRGB(235, 235, 235)
    noBtn.Text = "否"
    noBtn.TextColor3 = Color3.fromRGB(30, 30, 30)
    noBtn.TextSize = 12
    noBtn.Font = Enum.Font.SourceSansBold
    noBtn.Parent = frame
    local noCorner = Instance.new("UICorner")
    noCorner.CornerRadius = UDim.new(0, 7.5)
    noCorner.Parent = noBtn

    local enterTween = TweenService:Create(frame, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.new(1, -240, 0, 15) })
    enterTween:Play()

    local finished = false
    local choice = nil
    local choiceEvent = Instance.new("BindableEvent")

    local function leave(loadSource)
        if finished then return end
        finished = true
        choice = loadSource
        local exitTween
        if loadSource then
            exitTween = TweenService:Create(frame, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(1, -127.5, 0, 71.25) })
        else
            exitTween = TweenService:Create(frame, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Position = UDim2.new(1, 240, 0, 15) })
        end
        exitTween:Play()
        exitTween.Completed:Wait()
        popupGui:Destroy()
        choiceEvent:Fire()
    end

    yesBtn.MouseButton1Click:Connect(function()
        task.spawn(leave, true)
    end)
    noBtn.MouseButton1Click:Connect(function()
        task.spawn(leave, false)
    end)
    closeBtn.MouseButton1Click:Connect(function()
        task.spawn(leave, false)
    end)

    task.spawn(function()
        local deadline = os.clock() + 7
        while not finished and os.clock() < deadline do
            local left = deadline - os.clock()
            if left < 0 then left = 0 end
            local secs = math.floor(left)
            local cs = math.floor((left - secs) * 100)
            timeLabel.Text = string.format("%d:%02d", secs, cs)
            task.wait(0.05)
        end
        if not finished then
            leave(false)
        end
    end)

    choiceEvent.Event:Wait()
    return choice
end

