local function TriggerAllTouchInterests()
  local char = Players.LocalPlayer.Character
  if not char then return end
  local hrp = char:FindFirstChild("HumanoidRootPart")
  if not hrp then return end
  local range = triggerState.TouchTriggerRange or 20
  for _, v in ipairs(workspace:GetDescendants()) do
    if v:IsA("TouchTransmitter") or v.Name == "TouchInterest" then
      pcall(function()
        local touchPart = v.Parent
        if not touchPart or not touchPart:IsA("BasePart") then return end
        if range > 0 and (hrp.Position - touchPart.Position).Magnitude > range then return end
        if firetouchinterest then
          firetouchinterest(touchPart, hrp, 0)
          firetouchinterest(touchPart, hrp, 1)
        end
      end)
    end end
end

local function StartAutoTouch()
  triggerState.AutoTouchActive = true
  task.spawn(function()
    while triggerState.AutoTouchActive do
      TriggerAllTouchInterests()
      task.wait(triggerState.GlobalDelay or 0.1)
    end
  end)
end

