local function StartRemoteSpy()
  triggerState.SpyRemotes = true
  local mt = getrawmetatable(game)
  triggerState.OriginalNamecall = mt.__namecall
  setreadonly(mt, false)
  mt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    if triggerState.SpyRemotes and self:IsA("RemoteEvent") then
      table.insert(triggerState.RemoteLog, {
        Name = self:GetFullName(),
        Args = args,
        Time = tick()
      })
      if triggerState.ShowTriggerInfo then
        print(string.format("[远程监听] %s 已触发", self:GetFullName()))
      end end
    return triggerState.OriginalNamecall(self, ...)
  end)
  setreadonly(mt, true)
end

local function StopRemoteSpy()
  triggerState.SpyRemotes = false
  local mt = getrawmetatable(game)
  setreadonly(mt, false)
  if triggerState.OriginalNamecall then
    mt.__namecall = triggerState.OriginalNamecall
    triggerState.OriginalNamecall = nil
  end
  setreadonly(mt, true)
end

local function ShowRemoteLog()
  for i, log in ipairs(triggerState.RemoteLog) do
    local argsStr = ""
    for j, arg in ipairs(log.Args) do
      argsStr = argsStr .. tostring(arg)
      if j < #log.Args then argsStr = argsStr .. ", " end
    end
    print(string.format("[%d] %s - 参数: %s", i, log.Name, argsStr))
  end end

local function StartAutoReplayRemotes()
  triggerState.AutoReplayRemotes = true
  task.spawn(function()
    while triggerState.AutoReplayRemotes do
      if #triggerState.RemoteLog > 0 then
        local lastLog = triggerState.RemoteLog[#triggerState.RemoteLog]
        pcall(function()
          local parts = string.split(lastLog.Name, ".")
          local remote = game
          for _, name in ipairs(parts) do
            if remote then
              remote = remote:FindFirstChild(name)
            end end
          if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(unpack(lastLog.Args))
          end
        end)
      end
      task.wait(1)
    end
  end)
end

local function StopAutoReplayRemotes()
  triggerState.AutoReplayRemotes = false
end

local rangeCircle = nil

local function ToggleRangeCircle(state)
  triggerState.ShowRangeCircle = state
  if state then
    if rangeCircle then rangeCircle:Destroy() end
    rangeCircle = Instance.new("Part")
    rangeCircle.Name = "BS_RangeCircle"
    rangeCircle.Shape = Enum.PartType.Ball
    rangeCircle.Transparency = 0.7
    rangeCircle.Material = Enum.Material.Neon
    rangeCircle.BrickColor = BrickColor.new("Bright blue")
    rangeCircle.Anchored = true
    rangeCircle.CanCollide = false
    rangeCircle.Parent = workspace
    task.spawn(function()
      while triggerState.ShowRangeCircle do
        local char = Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
          local pos = char.HumanoidRootPart.Position
          rangeCircle.Position = pos
          local r = triggerState.TouchTriggerRange or 20
          rangeCircle.Size = Vector3.new(r * 2, r * 2, r * 2)
        end
        task.wait(0.1)
      end
      if rangeCircle then
        rangeCircle:Destroy()
        rangeCircle = nil
      end
    end)
  else
    if rangeCircle then
      rangeCircle:Destroy()
      rangeCircle = nil
    end end
end

local function createESPSection(section, title, stateKey, espType, espColor)
  section:Toggle({
    Title = "透视 " .. title,
    Value = false,
    Callback = function(state)
      triggerState[stateKey] = state
      if state then
        task.spawn(function()
          while triggerState[stateKey] do
            ESP_Clear()
            for _, v in ipairs(workspace:GetDescendants()) do
              if v:IsA(espType) then
                ESP_Create(v, espType, espColor)
              end end
            task.wait(1)
          end
        end)
      else
        ESP_Clear()
      end end
  })
end

