  end
end)

-- 单一渲染循环统一驱动（原为 3 个全局连接 + 每玩家各 1 个独立 RenderStepped 连接）
-- 性能优化：ESP 未开启时整帧跳过（默认全关时不空转），仅在状态切换帧做一次清理；首次开启时才创建全部绘制对象
RunService.RenderStepped:Connect(function()
  local cfg = espBeginFrame()
  if not cfg.ESPEnabled then
    if espMainActive then
      espMainActive = false
      for _, updater in pairs(ESPUpdaters) do updater(cfg) end
      updateRadar(cfg)
      updateHighlights(cfg)
      updateGlobalDrawings(cfg)
    end
    return
  end
  espMainActive = true

  if not espDrawingInit then
    espDrawingInit = true
    for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer then createESP(player) end
    end
    for player in pairs(ESPPending) do
      ESPPending[player] = nil
      if not ESPComponents[player] and player.Parent then createESP(player) end
    end
  elseif next(ESPPending) then
    for player in pairs(ESPPending) do
      ESPPending[player] = nil
      if not ESPComponents[player] and player.Parent then createESP(player) end
    end end

  updateGlobalDrawings(cfg)
  updateRadar(cfg)
  updateHighlights(cfg)
  for _, updater in pairs(ESPUpdaters) do
    updater(cfg)
  end
end)

