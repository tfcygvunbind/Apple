local settings = {
  disableShadows = false,
  disableEffects = false,
  simplifyMaterials = false,
  removeParticles = false,
  limitFPS = false,
  autoCleanup = false,
  fpsLimit = 120,
}

local cleanupConnection = nil
local isOptimized = false

local function toggleShadows(state)
  settings.disableShadows = state
  game.Lighting.GlobalShadows = not state
  if state then
    WindUI:Notify({ Title = "优化", Content = "阴影已关闭", Duration = 1 })
  else
    WindUI:Notify({ Title = "优化", Content = "阴影已开启", Duration = 1 })
  end end

local function toggleEffects(state)
  settings.disableEffects = state
  for _, v in ipairs(game.Lighting:GetDescendants()) do
    if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") then
      pcall(function()
        v.Enabled = not state
      end)
    end end
  if state then
    WindUI:Notify({ Title = "优化", Content = "后期特效已关闭", Duration = 1 })
  else
    WindUI:Notify({ Title = "优化", Content = "后期特效已开启", Duration = 1 })
  end end

local function toggleMaterials(state)
  settings.simplifyMaterials = state

  for _, v in ipairs(workspace:GetDescendants()) do
    if v:IsA("BasePart") or v:IsA("UnionOperation") or v:IsA("MeshPart") or v:IsA("CornerWedgePart") or v:IsA("TrussPart") then
      pcall(function()
        if state then
          v.Material = Enum.Material.Plastic
          v.Reflectance = 0
        else
        end
      end)
    end end
  if state then
    WindUI:Notify({ Title = "优化", Content = "材质已简化为 Plastic", Duration = 1 })
  else
    WindUI:Notify({ Title = "优化", Content = "材质已尝试恢复（需重进游戏完全恢复）", Duration = 1 })
  end end

local function toggleParticles(state)
  settings.removeParticles = state

  for _, v in ipairs(workspace:GetDescendants()) do
    if v:IsA("ParticleEmitter") or v:IsA("Trail") then
      pcall(function()
        if state then
          v.Lifetime = NumberRange.new(0)
        else
          v.Lifetime = NumberRange.new(1)
        end
      end)
    end
    if v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
      pcall(function()
        if state then
          v:Destroy()
        end
      end)
    end end
  if state then
    WindUI:Notify({ Title = "优化", Content = "粒子/火焰/烟雾已禁用", Duration = 1 })
  else
    WindUI:Notify({ Title = "优化", Content = "部分粒子已恢复，火焰/烟雾需重进游戏", Duration = 1 })
  end end

local function toggleAutoCleanup(state)
  settings.autoCleanup = state
  if state then
    if cleanupConnection then cleanupConnection:Disconnect() end
    cleanupConnection = workspace.DescendantAdded:Connect(function(child)
      task.spawn(function()
        if child:IsA("ForceField") or child:IsA("Sparkles") or child:IsA("Smoke") or child:IsA("Fire") then
          RunService.Heartbeat:Wait()
          child:Destroy()
        end
      end)
    end)
    WindUI:Notify({ Title = "优化", Content = "自动清理已开启", Duration = 1 })
  else
    if cleanupConnection then
      cleanupConnection:Disconnect()
      cleanupConnection = nil
    end
    WindUI:Notify({ Title = "优化", Content = "自动清理已关闭", Duration = 1 })
  end end

local function toggleFPS(state)
  settings.limitFPS = state
  local setfpscap = setfpscap or function() end
  pcall(function()
    if state then
      setfpscap(settings.fpsLimit)
      WindUI:Notify({ Title = "优化", Content = "帧率限制为 " .. settings.fpsLimit .. " FPS", Duration = 1 })
    else
      setfpscap(0)
      WindUI:Notify({ Title = "优化", Content = "帧率限制已移除", Duration = 1 })
    end
  end)
end

local function applyAll()
  if not settings.disableShadows then
    toggleShadows(true)
  end
  if not settings.disableEffects then
    toggleEffects(true)
  end
  if not settings.simplifyMaterials then
    toggleMaterials(true)
  end
  if not settings.removeParticles then
    toggleParticles(true)
  end
  if not settings.autoCleanup then
    toggleAutoCleanup(true)
  end
  if not settings.limitFPS then
    toggleFPS(true)
  end
  _N("优化", "所有优化已应用")
end

local function restoreAll()
  toggleShadows(false)
  toggleEffects(false)
  toggleMaterials(false)
  toggleParticles(false)
  toggleAutoCleanup(false)
  toggleFPS(false)
  _N("优化", "已尝试恢复默认（部分需重进游戏）")
end

