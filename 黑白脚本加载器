local actionTab = ctx.Tabs.Action
local actionSection = actionTab:Section({ Title = "动画控制", Opened = true })

local active = {}
local player = Players.LocalPlayer

local function clik()
  for _, track in pairs(active) do
    if track then
      pcall(function() track:Stop() end)
    end end
  active = {}
end

local function playAnimation(id, speed, fadeTime)
  task.spawn(function()
    clik()
    local char = player.Character or player.CharacterAdded:Wait()
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
      animator = Instance.new("Animator", humanoid)
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(id)
    local track = animator:LoadAnimation(anim)
    track.Looped = true
    track.Priority = Enum.AnimationPriority.Action
    track:Play(0, 1, fadeTime or 0)
    track:AdjustSpeed(speed or 1)
    table.insert(active, track)
    return track
  end)
end

