local tpInput = Tab1:Input({
  Title = "玩家速度V2",
  Default = "0",
  Callback = function(t)
    local v = tonumber(t) or 0
    v = v < 0 and 0 or v > 10 and 10 or v
    if not tpModule then
      local tp = {}
      local RS = svc("RunService")
      local active = false
      local dist = v
      local currentChar, currentHum, currentRoot = nil, nil, nil
      local states = {
        Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.FallingDown,
        Enum.HumanoidStateType.Flying, Enum.HumanoidStateType.Freefall,
        Enum.HumanoidStateType.GettingUp, Enum.HumanoidStateType.Jumping,
        Enum.HumanoidStateType.Landed, Enum.HumanoidStateType.Physics,
        Enum.HumanoidStateType.PlatformStanding, Enum.HumanoidStateType.Ragdoll,
        Enum.HumanoidStateType.Running, Enum.HumanoidStateType.RunningNoPhysics,
        Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.StrafingNoPhysics,
        Enum.HumanoidStateType.Swimming
      }

      local function updateRefs()
        local char = player.Character
        if char ~= currentChar then
          if currentHum then
            for _, s in ipairs(states) do
              currentHum:SetStateEnabled(s, true)
            end end
          currentChar = char
          if char then

            currentHum = char:FindFirstChild("Humanoid")
            currentRoot = char:FindFirstChild("HumanoidRootPart")
            if active and currentHum then
              for _, s in ipairs(states) do
                currentHum:SetStateEnabled(s, false)
              end end
          else
            currentHum, currentRoot = nil, nil
          end end
      end

      local _tpRayParams = RaycastParams.new()
      _tpRayParams.FilterType = Enum.RaycastFilterType.Exclude
      local _tpRayParamsChar = nil

      local function TP()
        if not active then return end
        updateRefs()
        if not currentRoot or not currentHum or not currentChar then return end
        local dir = currentHum.MoveDirection
        if dir.Magnitude == 0 then return end
        if currentChar ~= _tpRayParamsChar then
          _tpRayParams.FilterDescendantsInstances = {currentChar}
          _tpRayParamsChar = currentChar
        end
        local tv = dir * dist
        local res = workspace:Raycast(currentRoot.Position, tv, _tpRayParams)
        if res then
          tv = (res.Position - currentRoot.Position).Unit * dist
        end
        currentRoot.CFrame = currentRoot.CFrame + tv
      end

      local tpConn = nil
      function tp.Enabled(e)
        active = e
        updateRefs()
        if currentHum then
          for _, s in ipairs(states) do
            currentHum:SetStateEnabled(s, not e)
          end end
        if e then
          if not tpConn then tpConn = RS.Heartbeat:Connect(TP) end
        elseif tpConn then
          tpConn:Disconnect()
          tpConn = nil
        end end
      function tp.GetEnabled() return active end
      function tp.SetSpeed(s) dist = s or 0.1 end
      function tp.GetSpeed() return dist end

      tpModule = tp
    else
      tpModule.SetSpeed(v)
    end
    return tpModule
  end })
