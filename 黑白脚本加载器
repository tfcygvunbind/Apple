local function TriggerAllDialogs()
  local char = Players.LocalPlayer.Character
  if not char or not char:FindFirstChild("Humanoid") then return end
  local hum = char.Humanoid
  local range = triggerState.DialogRange or 20
  for _, dialog in ipairs(workspace:GetDescendants()) do
    if dialog:IsA("Dialog") then
      local parent = dialog.Parent
      if parent and parent:IsA("BasePart") then
        if (char.HumanoidRootPart.Position - parent.Position).Magnitude <= range then
          pcall(function()
            local choices = dialog:GetDialogChoices()
            if #choices > 0 then
              dialog:SignalDialogChoiceSelected(hum, choices[1])
            end
          end)
        end end
    end end
end

